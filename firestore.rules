rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Connection ping test document
    match /_connection_test/{docId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // User authentication / login records
    match /user_logins/{loginId} {
      allow read, write: if true;
    }

    // Farmer-specific login audit records
    match /farmer_logins/{loginId} {
      allow read, write: if true;
    }

    // Buyer-specific login audit records
    match /buyer_logins/{loginId} {
      allow read, write: if true;
    }

    // Farmer crop disease scanning and diagnostic data
    match /crop_scans/{scanId} {
      allow read, write: if true;
    }
    match /farmer_scans/{scanId} {
      allow read, write: if true;
    }

    // Marketplace Crop Listings
    match /listings/{listingId} {
      allow read, write: if true;
    }

    // Marketplace Orders and Deals (buyers name, farmer seller name, price, stock sold, addresses)
    match /marketplace_orders/{orderId} {
      allow read, write: if true;
    }

    // Marketplace Bids
    match /marketplace_bids/{bidId} {
      allow read, write: if true;
    }

    // Reviews & Feedback
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Activities & Audit logs
    match /activities/{activityId} {
      allow read, write: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
